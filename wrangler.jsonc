{
  "name": "pagedb",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": { "directory": "web/public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/", "/index.html"] },
  "durable_objects": { "bindings": [{ "name": "DB", "class_name": "DbObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DbObject"] }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pagedb" }],
  "triggers": { "crons": ["0 9 * * *"] },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // The public demo: the 100 GB base, one long-lived object (its city cache and SQLite stay warm).
  "vars": { "DEMO_DB": "db100g", "DEMO_OBJ": "demo100g" },
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }],
  "env": {
    // `npm run deploy:preview` → https://pagedb-preview.do-pool-lab.workers.dev: same base in R2,
    // its own objects (so its writes never reach the live demo). Secrets are set per Worker.
    "preview": {
      "name": "pagedb-preview",
      "durable_objects": { "bindings": [{ "name": "DB", "class_name": "DbObject" }] },
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pagedb" }],
      "triggers": { "crons": [] },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": { "DEMO_DB": "db100g", "DEMO_OBJ": "demo100g" }
    }
  }
}
