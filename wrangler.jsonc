{
  "name": "pagedb",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": { "directory": "web/public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/", "/index.html", "/hn", "/hn/", "/place", "/place/", "/sheet", "/sheet/"] },
  "durable_objects": { "bindings": [{ "name": "DB", "class_name": "DbObject" }, { "name": "HN_TAIL", "class_name": "HnTail" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DbObject"] }, { "tag": "v2", "new_sqlite_classes": ["HnTail"] }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pagedb" }],
  // Embeddings for semantic search (src/embed.ts).
  "ai": { "binding": "AI" },
  // 09:00 UTC: the tracker demo resets; every minute: keep the Hacker News tail alive.
  "triggers": { "crons": ["0 9 * * *", "* * * * *"] },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // The public demo: the 100 GB base, one long-lived object (its city cache and SQLite stay warm).
  "vars": { "DEMO_DB": "db100g", "DEMO_OBJ": "demo100g", "HN_DB": "hn", "HN_OBJ": "hn", "PLACE_DB": "place", "PLACE_OBJ": "place", "TAXI_DB": "taxi", "TAXI_OBJ": "taxi" },
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }],
  "env": {
    // `npm run deploy:preview` → https://pagedb-preview.do-pool-lab.workers.dev: same base in R2,
    // its own objects (so its writes never reach the live demo). Secrets are set per Worker.
    "preview": {
      "name": "pagedb-preview",
      "durable_objects": { "bindings": [{ "name": "DB", "class_name": "DbObject" }, { "name": "HN_TAIL", "class_name": "HnTail" }] },
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pagedb" }],
      "ai": { "binding": "AI" },
      "triggers": { "crons": ["* * * * *"] },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": { "DEMO_DB": "db100g", "DEMO_OBJ": "demo100g", "HN_DB": "hn", "HN_OBJ": "hn", "PLACE_DB": "place", "PLACE_OBJ": "place", "TAXI_DB": "taxi", "TAXI_OBJ": "taxi" }
    },
    // `npx wrangler deploy --env vec` → https://pagedb-vec.do-pool-lab.workers.dev: semantic search
    // over HN (a base with the stories' vector index attached: db "hnv"), its own objects.
    "vec": {
      "name": "pagedb-vec",
      "durable_objects": { "bindings": [{ "name": "DB", "class_name": "DbObject" }, { "name": "HN_TAIL", "class_name": "HnTail" }] },
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pagedb" }],
      "ai": { "binding": "AI" },
      "triggers": { "crons": ["* * * * *"] },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": { "DEMO_DB": "db100g", "DEMO_OBJ": "demo100g-vec", "HN_DB": "hnv", "HN_OBJ": "hnv", "HN_VEC": "story_vec", "PLACE_DB": "place", "PLACE_OBJ": "place-vec", "TAXI_DB": "taxi", "TAXI_OBJ": "taxi-vec" }
    }
  }
}
